# Copy to scripts/dev.env and adjust for your machine.
# Used by scripts/dev.ps1, scripts/dev.sh, and VS Code launch configs.

ENVIRONMENT=development
PYTHONPATH=.

# ── Platform center DB (registry / users / auth) — default MySQL ─────────────
PLATFORM_DB_TYPE=mysql
DATABASE_URL=mysql+aiomysql://smartbook:smartbook@localhost:3306/platform_registry
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=3306
PLATFORM_DB_USER=smartbook
PLATFORM_DB_PASSWORD=smartbook
PLATFORM_DB_NAME=platform_registry

# PostgreSQL platform center DB (optional override):
# PLATFORM_DB_TYPE=postgresql
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/platform_registry

# Infrastructure
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# Dev JWT (HS256, no key pair required locally)
JWT_ALGORITHM=HS256

# Local email/SMS — use console so OTP prints to backend logs (no SMTP needed)
EMAIL_PROVIDER=console

# Shared tenant DB (Account Set create/list when JWT has no account_set_id yet)
# SHARED_TENANT_DB_URL=mysql+aiomysql://smartbook:smartbook@localhost:3306/smartbook_shared

# Partial MCP support (stdio: python -m smartbook_mcp ; HTTP: set ENABLED + mount /mcp)
# SMARTBOOK_MCP_ENABLED=false
# SMARTBOOK_MCP_TOKEN=
# SMARTBOOK_MCP_REQUIRE_SESSION=false

# Frontend dev server (overridden by dev scripts)
# API_BASE_URL=http://localhost:8000
# PORT=8080
