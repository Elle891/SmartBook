{
  "uid": "database-fleet",
  "title": "Database Fleet",
  "tags": ["smart-accounting", "database"],
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Active DB Connections",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "DB Pool Utilization %",
      "type": "gauge",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "pg_stat_activity_count / pg_settings_max_connections * 100",
          "legendFormat": "pool %"
        }
      ],
      "options": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}
    },
    {
      "id": 3,
      "title": "Query Duration p99 (ms)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(db_query_duration_ms_bucket[5m])) by (le, tenant_db)) * 1000",
          "legendFormat": "{{tenant_db}} p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "DB Replication Lag",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "pg_replication_lag",
          "legendFormat": "replication lag (s)"
        }
      ]
    }
  ]
}
