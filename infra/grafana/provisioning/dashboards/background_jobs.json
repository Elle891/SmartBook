{
  "uid": "background-jobs",
  "title": "Background Jobs",
  "tags": ["smart-accounting", "celery"],
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Celery Queue Depth",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "celery_queue_length",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Task Success Rate",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(celery_tasks_total{state=\"SUCCESS\"}[5m])) by (name)",
          "legendFormat": "{{name}} success"
        }
      ]
    },
    {
      "id": 3,
      "title": "Task Failure Rate",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(celery_tasks_total{state=\"FAILURE\"}[5m])) by (name)",
          "legendFormat": "{{name}} failures"
        }
      ]
    },
    {
      "id": 4,
      "title": "Task Duration p99 (ms)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(celery_task_duration_seconds_bucket[5m])) by (le, name)) * 1000",
          "legendFormat": "{{name}} p99"
        }
      ]
    }
  ]
}
